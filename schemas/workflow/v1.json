{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runtrue.example/schemas/workflow/v1.json",
  "title": "Runtrue Workflow v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "jobs"],
  "properties": {
    "version": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "on": {"$ref": "#/$defs/triggers"},
    "inputs": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/inputDefinition"}
    },
    "outputs": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/workflowOutputDefinition"}
    },
    "permissions": {"$ref": "#/$defs/permissions"},
    "vars": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/scalar"}
    },
    "jobs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/job"}
    }
  },
  "$defs": {
    "scalar": {
      "anyOf": [
        {"type": "string"},
        {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
        {"type": "number", "not": {"type": "integer"}},
        {"type": "boolean"}
      ]
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digestPinnedReference": {
      "type": "string",
      "pattern": "^[^\\s]+@sha256:[0-9a-f]{64}$"
    },
    "workflowReference": {
      "type": "string",
      "pattern": "^git\\+(https|ssh)://[^\\s]+//[^\\s]+\\.ya?ml@[^\\s]+$"
    },
    "valueBinding": {
      "anyOf": [
        {"$ref": "#/$defs/scalar"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from"],
          "properties": {"from": {"type": "string"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["literal"],
          "properties": {"literal": {"$ref": "#/$defs/scalar"}}
        }
      ]
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "push": {"$ref": "#/$defs/gitTrigger"},
        "pull_request": {"$ref": "#/$defs/gitTrigger"},
        "merge_queue": {"type": "object", "additionalProperties": false},
        "schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cron"],
            "properties": {
              "cron": {"type": "string"},
              "timezone": {"type": "string", "default": "UTC"}
            }
          }
        },
        "manual": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inputs": {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/inputDefinition"}
            }
          }
        },
        "api": {"type": "object", "additionalProperties": false}
      }
    },
    "gitTrigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branches": {"type": "array", "items": {"type": "string"}},
        "branches-ignore": {"type": "array", "items": {"type": "string"}},
        "paths": {"type": "array", "items": {"type": "string"}},
        "paths-ignore": {"type": "array", "items": {"type": "string"}}
      }
    },
    "inputDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["string", "boolean", "integer", "number", "choice"]},
        "required": {"type": "boolean", "default": false},
        "default": {"$ref": "#/$defs/scalar"},
        "options": {"type": "array", "items": {"$ref": "#/$defs/scalar"}}
      }
    },
    "workflowOutputDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from"],
      "properties": {
        "from": {"type": "string", "pattern": "^needs\\.[A-Za-z_][A-Za-z0-9_-]{0,63}\\.outputs\\.[A-Za-z_][A-Za-z0-9_-]{0,63}$"}
      }
    },
    "cachePermissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": {"enum": ["deny", "public", "verified", "branch", "run"]},
        "write": {"enum": ["deny", "quarantine", "branch", "verified"]}
      }
    },
    "signingCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "operation", "key-policy"],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "operation": {"enum": ["sign-digest", "sign-attestation"]},
        "key-policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      }
    },
    "scmPermissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contents": {"enum": ["deny", "read", "write"]},
        "issues": {"enum": ["deny", "read", "write"]},
        "pull-requests": {"enum": ["deny", "read", "write"]},
        "checks": {"enum": ["deny", "read", "write"]},
        "statuses": {"enum": ["deny", "read", "write"]}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"enum": ["deny", "read", "write"]},
        "scm": {"$ref": "#/$defs/scmPermissions"},
        "checks": {"enum": ["deny", "read", "write"]},
        "artifacts": {"enum": ["deny", "read", "write"]},
        "registry": {"enum": ["deny", "read", "write"]},
        "network": {
          "oneOf": [
            {"enum": ["deny"]},
            {"$ref": "#/$defs/networkPolicy"}
          ]
        },
        "oidc": {
          "oneOf": [
            {"enum": ["deny"]},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["audiences"],
              "properties": {
                "audiences": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              }
            }
          ]
        },
        "cache": {"$ref": "#/$defs/cachePermissions"},
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {"type": "string"},
              "purpose": {"type": "string"}
            }
          }
        },
        "signing": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/signingCapability"}
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dns": {"enum": ["deny", "restricted", "allow"]},
        "deny-private-ranges": {"type": "boolean", "default": true},
        "allow": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "port"],
            "properties": {
              "host": {"type": "string"},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535},
              "protocol": {"enum": ["tcp", "udp"], "default": "tcp"}
            }
          }
        },
        "listen": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1, "maximum": 65535}
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "needs": {"type": "array", "items": {"type": "string"}},
        "if": {"type": "string"},
        "uses": {"$ref": "#/$defs/workflowReference"},
        "with": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"},
          "additionalProperties": {"$ref": "#/$defs/scalar"}
        },
        "trust": {"enum": ["untrusted-ok", "trusted-only", "protected-branch-only"]},
        "environment": {"type": "string"},
        "runner": {"$ref": "#/$defs/runner"},
        "permissions": {"$ref": "#/$defs/permissions"},
        "timeout": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
        "retries": {"type": "integer", "minimum": 0, "maximum": 10},
        "matrix": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"},
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/scalar"}
          }
        },
        "concurrency": {"type": "string"},
        "vars": {"type": "object", "additionalProperties": {"$ref": "#/$defs/scalar"}},
        "services": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/service"}
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/outputDefinition"}
        }
      },
      "oneOf": [
        {
          "required": ["uses"],
          "not": {
            "anyOf": [
              {"required": ["trust"]},
              {"required": ["environment"]},
              {"required": ["runner"]},
              {"required": ["permissions"]},
              {"required": ["timeout"]},
              {"required": ["retries"]},
              {"required": ["matrix"]},
              {"required": ["concurrency"]},
              {"required": ["vars"]},
              {"required": ["services"]},
              {"required": ["steps"]},
              {"required": ["outputs"]}
            ]
          }
        },
        {
          "required": ["steps"],
          "not": {"anyOf": [{"required": ["uses"]}, {"required": ["with"]}]}
        }
      ]
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {"enum": ["linux", "windows", "macos"]},
        "arch": {"enum": ["amd64", "arm64"]},
        "isolation": {"enum": ["wasm", "oci", "microvm", "native"]},
        "image": {"type": "string", "minLength": 1},
        "cpu": {"type": "integer", "minimum": 1},
        "memory": {"type": "string"},
        "storage": {"type": "string"},
        "region": {"type": "string"},
        "capabilities": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {
            "required": ["isolation"],
            "properties": {"isolation": {"const": "oci"}}
          },
          "then": {"required": ["image"]},
          "else": {"not": {"required": ["image"]}}
        }
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": {"$ref": "#/$defs/digestPinnedReference"},
        "ports": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
        "env": {"type": "object", "additionalProperties": {"$ref": "#/$defs/valueBinding"}},
        "healthcheck": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {"type": "array", "items": {"type": "string"}},
            "interval": {"type": "string"},
            "timeout": {"type": "string"},
            "retries": {"type": "integer", "minimum": 1, "maximum": 100}
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"},
        "name": {"type": "string"},
        "if": {"type": "string"},
        "uses": {"$ref": "#/$defs/digestPinnedReference"},
        "with": {"type": "object", "additionalProperties": {"$ref": "#/$defs/valueBinding"}},
        "run": {"$ref": "#/$defs/run"},
        "env": {"type": "object", "additionalProperties": {"$ref": "#/$defs/valueBinding"}},
        "capabilities": {"$ref": "#/$defs/stepCapabilities"},
        "cache": {"$ref": "#/$defs/cacheDeclaration"},
        "timeout": {"type": "string"},
        "continue-on-error": {"type": "boolean", "default": false}
      },
      "oneOf": [
        {"required": ["uses"], "not": {"required": ["run"]}},
        {
          "required": ["run"],
          "not": {
            "anyOf": [
              {"required": ["uses"]},
              {"required": ["with"]}
            ]
          }
        }
      ]
    },
    "run": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "args": {"type": "array", "items": {"$ref": "#/$defs/valueBinding"}},
            "working-directory": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["shell", "script"],
          "properties": {
            "shell": {"enum": ["bash", "sh", "pwsh", "cmd"]},
            "script": {"type": "string"},
            "working-directory": {"type": "string"},
            "unsafe-interpolation": {"type": "boolean", "default": false}
          }
        }
      ]
    },
    "stepCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read": {"type": "array", "items": {"type": "string"}},
            "write": {"type": "array", "items": {"type": "string"}}
          }
        },
        "network": {"$ref": "#/$defs/networkPolicy"},
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {"type": "string"},
              "purpose": {"type": "string"}
            }
          }
        },
        "checks": {"enum": ["deny", "read", "write"]},
        "artifacts": {"enum": ["deny", "read", "write"]},
        "cache": {"$ref": "#/$defs/cachePermissions"},
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["audiences"],
          "properties": {
            "audiences": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        },
        "signing": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/signingCapability"}
        }
      }
    },
    "cacheDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputs": {"type": "array", "items": {"type": "string"}},
        "outputs": {"type": "array", "items": {"type": "string"}},
        "mode": {"enum": ["read-only", "read-write", "write-only"]},
        "max-size": {"type": "string"}
      }
    },
    "outputDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string"},
        "retention": {"type": "string"},
        "classification": {"enum": ["untrusted-build", "quarantined", "verified-test-output", "release-candidate", "promoted-release", "sensitive", "public"]}
      }
    }
  }
}
