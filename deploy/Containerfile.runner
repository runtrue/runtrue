# syntax=docker/dockerfile:1.10@sha256:865e5dd094beca432e8c0a1d5e1c465db5f998dca4e439981029b3b81fb39ed5
ARG RUST_IMAGE=docker.io/library/rust:1.94.0-bookworm@sha256:365468470075493dc4583f47387001854321c5a8583ea9604b297e67f01c5a4f
ARG RUNTIME_IMAGE=docker.io/library/ubuntu:26.04@sha256:3131b4cc82a783df6c9df078f86e01819a13594b865c2cad47bd1bca2b7063bb

FROM ${RUST_IMAGE} AS build
ENV RUSTUP_TOOLCHAIN=1.94.0
WORKDIR /src
COPY . .
RUN --mount=type=cache,id=runtrue-runner-cargo-registry-v1,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=runtrue-runner-cargo-git-v1,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=runtrue-runner-release-target-v1,target=/src/target,sharing=locked \
    cargo build --locked --release -p runtrue-runner --bin runtrue-runner && \
    install -D -m 0555 target/release/runtrue-runner /out/runtrue-runner

FROM ${RUNTIME_IMAGE} AS runner
ARG RUNTRUE_VERSION=0.1.0
ARG RUNTRUE_REVISION=unknown
ARG RUNTRUE_RUNTIME_UID=10001
ARG RUNTRUE_RUNTIME_GID=10001
LABEL org.opencontainers.image.title="Runtrue runner" \
      org.opencontainers.image.version="${RUNTRUE_VERSION}" \
      org.opencontainers.image.revision="${RUNTRUE_REVISION}" \
      org.opencontainers.image.source="https://github.com/runtrue/runtrue" \
      org.opencontainers.image.licenses="Apache-2.0"

# One image supports every runner deployment shape. Wasm remains the
# least-privilege default because OCI is activated only when the operator
# supplies the complete OCI configuration and the service receives /dev/fuse.
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      ca-certificates \
      fuse-overlayfs \
      podman \
      procps \
      slirp4netns \
      uidmap && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid "${RUNTRUE_RUNTIME_GID}" runtrue && \
    useradd --uid "${RUNTRUE_RUNTIME_UID}" --gid "${RUNTRUE_RUNTIME_GID}" \
      --create-home --home-dir /var/lib/runtrue/runner/home \
      --shell /usr/sbin/nologin runtrue && \
    printf 'runtrue:165536:65536\n' > /etc/subuid && \
    printf 'runtrue:165536:65536\n' > /etc/subgid && \
    install -d -o "${RUNTRUE_RUNTIME_UID}" -g "${RUNTRUE_RUNTIME_GID}" -m 0700 \
      /var/lib/runtrue/runner \
      /var/lib/runtrue/runner/home \
      /var/lib/runtrue/workspaces
COPY --from=build --chown=0:0 /out/runtrue-runner /usr/local/bin/runtrue-runner
COPY --chown=0:0 deploy/containers-oci.conf /etc/containers/containers.conf.d/99-runtrue.conf
RUN chmod 0555 /usr/local/bin/runtrue-runner && \
    chmod 0444 /etc/containers/containers.conf.d/99-runtrue.conf
USER ${RUNTRUE_RUNTIME_UID}:${RUNTRUE_RUNTIME_GID}
WORKDIR /var/lib/runtrue/workspaces
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/runtrue-runner"]
