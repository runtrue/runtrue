# Copy to deploy/state/github-app.env, set mode 0600, and replace every
# example value. This file contains no App private key or webhook secret.

# Externally reachable HTTPS origin for Runtrue's setup callback and browser UI.
RUNTRUE_PUBLIC_ORIGIN=https://runtrue.example.com
RUNTRUE_ACME_EMAIL=operator@example.com

RUNTRUE_GITHUB_APP_ID=123
RUNTRUE_GITHUB_APP_SLUG=runtrue

# GitHub browser login. User ids must be stable positive numeric ids, not login
# names.
RUNTRUE_GITHUB_OAUTH_CLIENT_ID=Iv1.example
RUNTRUE_GITHUB_OAUTH_ADMIN_USER_IDS=123456

# Run an independent, network-disabled JWT provider as the deployment uid and
# have it create:
#   RUNTRUE_STATE_DIR/github-app-provider/provider.sock
# The socket must be owned by root or the deployment uid with exact mode 0600.
