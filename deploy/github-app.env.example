# Copy to deploy/state/github-app.env, set mode 0600, and replace every
# example value. This file contains no App private key or webhook secret.

# Externally reachable HTTPS origin for Runtrue's setup callback and browser UI.
RUNTRUE_PUBLIC_ORIGIN=https://runtrue.example.com

RUNTRUE_GITHUB_APP_ID=123
RUNTRUE_GITHUB_APP_SLUG=runtrue

# GitHub Enterprise Server example. For GitHub.com use:
#   RUNTRUE_GITHUB_WEB_ORIGIN=https://github.com
#   RUNTRUE_GITHUB_API_ORIGIN=https://api.github.com
RUNTRUE_GITHUB_WEB_ORIGIN=https://github.example.com
RUNTRUE_GITHUB_API_ORIGIN=https://github.example.com/api/v3

RUNTRUE_GITHUB_APP_CREDENTIAL_REFERENCE=provider://github-app/production

# Absolute host path to a pre-existing mode-0600 Unix stream socket. Its owner
# must be root or the numeric RUNTRUE_RUNTIME_UID used by Compose.
RUNTRUE_GITHUB_SIGNER_SOCKET=/run/user/1000/runtrue/github-app-signer.sock
